# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=dev

# Database (MySQL)
MYSQL_DATABASE=ai_sales
MYSQL_USER=ai_sales
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Field-level encryption — required now (apps.integrations.models.Integration.credentials
# uses this to encrypt WhatsApp/etc. access tokens at rest). Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# CORS - comma separated origins allowed to call the dashboard API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI Provider (managed, Phase 1 default)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-changeme
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Billing (manual = admin/owner picks a plan, no gateway wired up yet)
PAYMENT_PROVIDER=manual

# Storage
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
