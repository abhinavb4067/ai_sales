# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=dev

# Database (PostgreSQL + pgvector)
POSTGRES_DATABASE=ai_sales
POSTGRES_USER=ai_sales
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Field-level encryption — required now (apps.integrations.models.Integration.credentials
# uses this to encrypt WhatsApp/etc. access tokens at rest). Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# CORS - comma separated origins allowed to call the dashboard API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI Provider (managed, Phase 1 default). Agents pick their own provider
# (openai/gemini/local) individually — these are the platform-managed keys
# used for whichever provider each agent selects.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-changeme
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=changeme
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional external dedicated vector store — leave blank to use the
# native Postgres pgvector column instead (the default; no separate
# service to run). Only set this if you specifically want a standalone
# vector DB instead of pgvector.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ectama_knowledge_chunks

# Must match the embedding model's output dimensions (OpenAI
# text-embedding-3-small=1536, Gemini text-embedding-004=768). Changing
# this requires re-embedding existing knowledge, it is not retroactive.
EMBEDDING_VECTOR_DIMENSIONS=1536

# Billing (manual = admin/owner picks a plan, instant activation, no real
# charge. Set to "razorpay" once a real Razorpay account/keys exist —
# each Plan also needs its razorpay_plan_id set, e.g. via Django admin.)
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# WhatsApp Embedded Signup (optional) — leave blank to keep the manual
# "paste your own WABA credentials" connection flow as the only option.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_CONFIG_ID=

# Error monitoring (optional) — leave blank to disable Sentry entirely
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Storage
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
